# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your keys never reach GitHub.

# Which AI runs the steps: "anthropic" (Claude, the default) or "gemini" (Google AI Studio).
AI_PROVIDER=anthropic

# Anthropic API key (console.anthropic.com). Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Model used for the AI steps. Haiku is cheap for development; switch to Sonnet for demos.
ANTHROPIC_MODEL=claude-haiku-5-5

# Google AI Studio key (aistudio.google.com/apikey), used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Access code visitors must enter before an audit runs. Leave empty to disable (local dev only).
ACCESS_CODE=

# Upstash Redis (saved reports, rate limits) — planned for Milestone 4, not used yet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
