# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your keys never reach GitHub.

# Which AI runs the steps: "anthropic" (Claude, the default) or "gemini" (Google AI Studio).
AI_PROVIDER=anthropic

# Anthropic API key (console.anthropic.com). Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Model used for the AI steps. Haiku is cheap for development; switch to Sonnet for demos.
ANTHROPIC_MODEL=claude-haiku-5-5

# Google AI Studio key (aistudio.google.com/apikey), used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Two models: GEMINI_MODEL for the growth audit and the social media post (where quality shows),
# GEMINI_MODEL_FAST for brand voice and the automation plan (about a fifth of the price).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite

# Access code for unlimited audits (you and your demos). Leave empty to allow everyone without limits (local dev only).
# With Upstash configured, visitors without the code get a few free audits per day instead of being refused.
ACCESS_CODE=

# Upstash Redis (console.upstash.com → your database → REST API): saved, shareable reports and rate limits.
# Without these, reports aren't saved and only the access code works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Free audits for visitors without the access code (optional; these are the defaults).
PUBLIC_AUDITS_PER_VISITOR_PER_DAY=3
PUBLIC_AUDITS_PER_DAY=15

# Google PageSpeed Insights API key (free, 25,000 requests/day): speed and mobile scores in the audit.
# Google Cloud console → APIs & Services → enable "PageSpeed Insights API" → Credentials → Create API key.
# Without it, the speed step is skipped.
PAGESPEED_API_KEY=

# Lead alerts: a Slack or Discord "incoming webhook" URL. When someone clicks a "Message me on LinkedIn"
# button, a short message with the website and the offer is posted there (max 30 a day). Optional.
LEAD_ALERT_WEBHOOK_URL=
